# Copy this file to .env and fill in your own MySQL credentials.
# .env is git-ignored - credentials never go into the source code or into git.

# mysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql://tasklist_user:change_me@localhost:3306/tasklist

# Address the API listens on
SERVER_ADDR=127.0.0.1:3000

# Size of the MySQL connection pool
DB_MAX_CONNECTIONS=5

# Log level (error | warn | info | debug | trace)
RUST_LOG=tasklist_api=debug,tower_http=info
